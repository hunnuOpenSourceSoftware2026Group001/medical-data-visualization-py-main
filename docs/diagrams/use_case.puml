@startuml 用例图
left to right direction
skinparam packageStyle rectangle

actor "医生/医务人员" as Doctor
actor "数据分析师" as Analyst
actor "系统管理员" as Admin
actor "DeepSeek 大模型" as LLM

rectangle "医疗疾病数据可视化与智能分析系统" {
  usecase "UC1 患者病例管理" as UC1
  usecase "UC2 数据可视化大屏" as UC2
  usecase "UC3 疾病预测" as UC3
  usecase "UC4 报告生成" as UC4
  usecase "UC5 AI 医疗咨询" as UC5
  usecase "UC6 数据导入导出" as UC6
  usecase "统一异常处理" as UC7
}

Doctor --> UC1
Doctor --> UC2
Doctor --> UC3
Doctor --> UC5
Analyst --> UC2
Analyst --> UC4
Admin --> UC1
Admin --> UC6
UC1 .> UC6 : include(导入/导出)
UC5 --> LLM : 调用(可降级)
UC1 ..> UC7 : 异常
UC3 ..> UC7 : 异常
UC4 ..> UC7 : 异常
@enduml
